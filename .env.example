# Für Änderungen an dieser Datei den Dienst neu starten.
HOST=0.0.0.0
PORT=8080
DATA_DIR=/var/lib/familien-organisierer
# Leer = DATA_DIR/photos. Eigene Ordner brauchen Schreibrechte für den Dienst.
PHOTO_DIR=
# Für lokalen Betrieb ohne Google zunächst leer lassen.
# Für Google z.B. https://familie.deine-eigene-domain.de (ohne abschließenden Pfad).
APP_URL=
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optionaler Speicherort für Sicherungen. Standard: ./backups
BACKUP_DIR=
